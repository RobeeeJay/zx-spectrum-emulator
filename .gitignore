/target

# Machine ROMs are copyrighted (Sinclair/Amstrad) and are not distributed with
# this source. Drop your own images in roms/ — see the README.
/roms/*
!/roms/.gitkeep

# Likewise the games: put your own .tzx/.tap files in tapes/.
/tapes/*
!/tapes/.gitkeep

.DS_Store
*.afdesign~lock~
recordings/

# Snapshots are of somebody's game, taken from a copyrighted tape, for the same
# reason the tapes themselves are not here.
snapshots/

# Model answers, listings and traces: generated, and often large.
out/
